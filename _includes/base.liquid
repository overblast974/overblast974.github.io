{%- assign e = entreprise -%}
{%- assign adresse = page.url | replace: "/index.html", "/" -%}
{%- if robots == blank %}{% assign robots = "index, follow" %}{% endif -%}
{%- assign reservation = "/#reservation" -%}
{%- if accueil %}{% assign reservation = "#reservation" %}{% endif -%}
{%- assign tel = e.contact.telephone -%}
{%- comment -%} Les descriptions des pages ne recopient aucune valeur : renvois {seance}, {telephone}… (recette MA-3). {%- endcomment -%}
{%- assign description = description | remplir | texte_brut -%}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; upgrade-insecure-requests">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ titre }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="{{ robots }}">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="theme-color" content="#FFFFFF">
  <meta name="color-scheme" content="light">
  <link rel="canonical" href="https://coachapar.fr{{ adresse }}">
  <meta property="og:type" content="{% if article %}article{% else %}website{% endif %}">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="{{ e.identite.nom }}">
  <meta property="og:url" content="https://coachapar.fr{{ adresse }}">
  <meta property="og:title" content="{{ partage_titre | default: titre }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://coachapar.fr/images/partage/{{ partage_image | default: 'accueil' }}.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ e.identite.nom }} — {{ partage_alt | default: titre }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/site.css">
  <noscript><link rel="stylesheet" href="/css/sans-script.css"></noscript>
  <script src="/js/site.js" defer></script>
{%- assign blocs = page.url | schema: schema, fil, faq, service, diplomes, article %}
{%- for b in blocs %}
  <script type="application/ld+json">
{{ b }}
  </script>
{%- endfor %}
</head>
<body{% if classe_corps %} class="{{ classe_corps }}"{% endif %}>
  <a class="skip-link" href="#contenu">Aller au contenu</a>
{% include "en-tete.liquid" %}
  <main id="contenu" tabindex="-1">
{{ content }}
  </main>
{% include "pied.liquid" %}
</body>
</html>
